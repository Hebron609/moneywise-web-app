# ==============================================================================
# MoneyWise SHS — Supabase & Next.js Environment Variables
# Copy to .env.local for local development, and add to Vercel Project Settings
# ==============================================================================

# Supabase Project URL & Anon Key (from Project Settings -> API in Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional legacy backend proxy (if applicable)
NEXT_PUBLIC_API_BASE_URL=https://appsuite.butterflytech.io/api
NEXT_PUBLIC_ENABLE_TOKEN_TOOL=false
